package {{ package }};

import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.level.Level;
{% if behavior_methods %}
import net.minecraft.world.effect.MobEffectInstance;
import net.minecraft.world.effect.MobEffects;
import net.minecraft.world.InteractionHand;
import net.minecraft.world.InteractionResult;
import net.minecraft.world.entity.player.Player;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.LightningBolt;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.core.BlockPos;
{% endif %}

public class {{ class_name }} extends Item {
    
    public {{ class_name }}(Properties properties) {
        super(properties);
    }
    
{% if behavior_methods %}
{% for method in behavior_methods %}
{% if method.name == 'finishUsingItem' %}
    @Override
    public ItemStack finishUsingItem(ItemStack stack, Level level, LivingEntity entity) {
        if (!level.isClientSide() && entity instanceof Player player) {
{% for effect in method.effects %}
            player.addEffect(new MobEffectInstance(MobEffects.{{ effect.type | upper }}, {{ effect.duration }}, {{ effect.amplifier }}));
{% endfor %}
        }
        return super.finishUsingItem(stack, level, entity);
    }
{% endif %}

{% if method.name == 'use' and method.action == 'summon_lightning' %}
    @Override
    public InteractionResult use(Level level, Player player, InteractionHand hand) {
        if (!level.isClientSide() && level instanceof ServerLevel serverLevel) {
            BlockPos pos = player.blockPosition();
            LightningBolt bolt = new LightningBolt(EntityType.LIGHTNING_BOLT, serverLevel);
            bolt.setPos(pos.getX(), pos.getY(), pos.getZ());
            serverLevel.addFreshEntity(bolt);
        }
        player.startUsingItem(hand);
        return InteractionResult.SUCCESS;
    }
{% endif %}
{% endfor %}
{% else %}
    // TODO: Implement custom item behavior here
{% endif %}
}

